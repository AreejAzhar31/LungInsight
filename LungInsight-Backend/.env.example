# Application
APP_NAME=LungInsight AI Backend
APP_ENV=development
DEBUG=true

# Database
# Production/dev (PostgreSQL): postgresql+psycopg2://user:password@localhost:5432/lunginsight
# Async engine variant used internally: postgresql+asyncpg://user:password@localhost:5432/lunginsight
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lunginsight

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# Rate limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# AI model inference
# stub = fake response, no model service needed (default, used by tests)
# http = calls the real model-serving microservice (ai/service/main.py)
INFERENCE_MODE=stub
INFERENCE_SERVICE_URL=http://localhost:8500
INFERENCE_TIMEOUT_SECONDS=30
HEATMAP_DIR=uploads/heatmaps

# RAG clinical chat
# stub = fake response, no RAG service needed (default, used by tests)
# http = calls the real RAG microservice (rag/api.py)
RAG_MODE=stub
RAG_SERVICE_URL=http://localhost:8600
RAG_TIMEOUT_SECONDS=30
